# =============================================================================
# Remi backend — PRODUCTION environment (Hostinger VPS). Template only: the real file lives on the
# server at /opt/remi/.env.production (chmod 600) and is never committed. Development never uses
# this file or Supabase: backend/.env points at the local Postgres, and the API refuses to start in
# development/test against a Supabase host (see src/config/database-target.ts).
# Generate every secret with: openssl rand -base64 48   (ENCRYPTION_KEY: openssl rand -base64 32)
# =============================================================================

# ---- runtime ----
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
API_PUBLIC_URL=https://api.example.com
WEB_URL=https://example.com
ADMIN_URL=https://admin.example.com
CORS_ORIGINS=https://example.com,https://admin.example.com
# shared parent domain of web, admin and api, so the auth cookies reach the Next.js route guards
COOKIE_DOMAIN=.example.com
COOKIE_SECURE=true
# Caddy runs on the same Docker network: trust exactly one proxy hop
TRUST_PROXY=1
SWAGGER_ENABLED=false
JSON_BODY_LIMIT=1mb

# ---- database: Supabase (production only) ----
# App: transaction pooler (port 6543). @prisma/adapter-pg needs no pgbouncer flag.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true
# Migrations (prisma migrate deploy in the `migrate` container): session pooler (port 5432, IPv4).
# The direct db.<ref>.supabase.co host is IPv6-only on most plans.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
DATABASE_POOL_MAX=10

# ---- Supabase Storage (recordings bucket) — Project settings → API keys → service_role ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECORDINGS_BUCKET=recordings

# ---- Redis (the `redis` service of the production compose stack) ----
REDIS_URL=redis://redis:6379

# ---- auth ----
JWT_ACCESS_SECRET=
ADMIN_JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OAUTH_STATE_SECRET=
ENCRYPTION_KEY=

# ---- Google OAuth + Calendar (authorised redirect URI must match exactly) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback
MOBILE_REDIRECT_ALLOWLIST=remi://

# ---- Gemini (required: AI_MOCK must be false in production) ----
GEMINI_API_KEY=
AI_MOCK=false

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- email (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Expo push (optional) ----
EXPO_ACCESS_TOKEN=

# ---- first super admin (created on boot when the admins table is empty) ----
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Super Admin

# ---- website revalidation (same secret as REVALIDATE_SECRET in the Vercel website project) ----
WEB_REVALIDATE_URL=https://example.com/api/revalidate
WEB_REVALIDATE_SECRET=

# ---- meeting bot ----
BOT_MODE=puppeteer
BOT_CONCURRENCY=1
CHROME_PATH=/usr/bin/chromium

# ---- scheduling ----
CALENDAR_SYNC_INTERVAL_MINUTES=10
