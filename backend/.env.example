# =============================================================================
# Remi backend environment. Copy to backend/.env and fill in. Validated at boot (src/config/env.schema.ts);
# the process refuses to start with a readable error when something is missing or unsafe.
# In NODE_ENV=production the boot also fails on example/weak secrets, COOKIE_SECURE=false,
# AI_MOCK=true, exp:// in MOBILE_REDIRECT_ALLOWLIST or "*" in CORS_ORIGINS.
# =============================================================================

# ---- runtime ----
# development | production | test
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent (JSON logs in production, pretty in dev)
LOG_LEVEL=info
API_PUBLIC_URL=http://localhost:4000
# OAuth callback target (/auth/callback) and links in notifications
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# exact origins, never "*" (defaults to WEB_URL,ADMIN_URL)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# e.g. .example.com in production (web + api on subdomains)
COOKIE_DOMAIN=
# must be true in production
COOKIE_SECURE=false
# false | true | hop count (1) | subnets ("loopback, 10.0.0.0/8") — real client IP for rate limits
TRUST_PROXY=false
# default: true in development, false in production
SWAGGER_ENABLED=
JSON_BODY_LIMIT=1mb

# ---- database: LOCAL Postgres (development/test always use a local DB; Supabase is production-only) ----
# `docker compose up -d postgres` publishes Postgres + pgvector on localhost:5433 (5433 avoids clashing with a
# Homebrew Postgres on 5432). Containers in the compose stack override these with postgres:5432.
# Production (Supabase pooler URLs): see backend/.env.production.example.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/remi
# used only by the Prisma CLI (migrate deploy/dev, db execute)
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/remi
DATABASE_POOL_MAX=10
# only for `prisma migrate dev`
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/remi_shadow
# The API and the Prisma CLI refuse to run in development/test against a Supabase host; set true only on purpose.
ALLOW_REMOTE_DB_IN_DEV=false

# ---- Supabase Storage (recordings bucket; production only — uploads are disabled in local dev) ----
# e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECORDINGS_BUCKET=recordings

# ---- Redis (queues, cache, rate limits, one-time codes, Socket.IO) ----
REDIS_URL=redis://localhost:6380

# ---- auth (generate each with: openssl rand -base64 48) ----
JWT_ACCESS_SECRET=change-me-user-jwt-secret-at-least-32-characters-long
ADMIN_JWT_ACCESS_SECRET=change-me-admin-jwt-secret-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OAUTH_STATE_SECRET=change-me-oauth-state-secret-at-least-32-characters
# AES-256-GCM key for Google tokens at rest: openssl rand -base64 32
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ---- Google OAuth + Calendar ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# production: remi:// only (exp:// is rejected)
MOBILE_REDIRECT_ALLOWLIST=remi://,exp://

# ---- Gemini ----
GEMINI_API_KEY=
# true = deterministic fake reports/embeddings (local testing without a key)
AI_MOCK=false

# ---- Cloudinary (admin media; dummy values disable uploads, admins can still paste https image URLs) ----
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=dummy
CLOUDINARY_API_SECRET=dummy

# ---- email (optional; also needs app_settings.notifications.emailEnabled and the user's opt-in) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Expo push (optional access token for enhanced security) ----
EXPO_ACCESS_TOKEN=

# ---- first super admin (created on API boot when the admins table is empty; ≥12 chars) ----
ADMIN_SEED_EMAIL=admin@remi.local
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Super Admin

# ---- website on-demand revalidation (best effort POST {"tags":["config"]} with x-revalidate-secret) ----
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
WEB_REVALIDATE_SECRET=

# ---- meeting bot ----
# puppeteer (real Google Meet via Chromium) | simulate (sample transcript)
BOT_MODE=simulate
BOT_CONCURRENCY=1
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_PATH=/usr/bin/chromium

# ---- Recall.ai managed meeting bots (admin → Meeting bot → Provider = Recall.ai) ----
# API key from the Recall.ai dashboard (Developers → API Keys) of the region below.
RECALL_API_KEY=
# us-east-1 | us-west-2 | eu-central-1 | ap-northeast-1 (where the Recall.ai workspace lives)
RECALL_REGION=us-east-1
# Workspace verification secret (Developers → API Keys & Secrets), starts with whsec_
RECALL_WEBHOOK_SECRET=

# ---- scheduling ----
CALENDAR_SYNC_INTERVAL_MINUTES=10


# 1. Server par 3 lines daalo (jiske paas SSH access hai):
# ssh root@194.238.16.75
# cd /opt/remi
# nano .env.production      and  File ke end mein:  


RECALL_API_KEY=
RECALL_REGION=
RECALL_WEBHOOK_SECRET=