  url          String
  resourceType String   @default("image") @map("resource_type")
  format       String?
  width        Int?
  height       Int?
  bytes        Int?
  folder       String?
  alt          String?
  uploadedBy   String?  @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  uploader Admin? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "media_assets_created_idx")
  @@map("media_assets")
}

model AiPrompt {
  key         String   @id
  name        String
  description String?
  content     String
  version     Int      @default(1)
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  updater Admin? @relation(fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("ai_prompts")
}

model NotificationTemplate {
  key           String   @id
  name          String
  titleTemplate String   @map("title_template")
  bodyTemplate  String   @map("body_template")
  emailSubject  String?  @map("email_subject")
  emailBody     String?  @map("email_body")
  channels      String[] @default(["push", "in_app"])
  isActive      Boolean  @default(true) @map("is_active")
  updatedBy     String?  @map("updated_by") @db.Uuid
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  updater Admin? @relation(fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("notification_templates")
}

model Broadcast {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  body      String
  data      Json     @default("{}")
  audience  Json     @default("{\"type\":\"all\"}")
  channels  String[] @default(["push", "in_app"])
  sentCount Int      @default(0) @map("sent_count")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  creator Admin? @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("broadcasts")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  adminId   String?  @map("admin_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  changes   Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "audit_logs_created_idx")
  @@index([entity, entityId], map: "audit_logs_entity_idx")
  @@map("audit_logs")
}
