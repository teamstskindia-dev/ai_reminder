// Remi data model. Mirrors prisma/migrations/20261103000000_init/migration.sql exactly
// (snake_case tables/columns via @@map/@map, camelCase fields in TypeScript).
//
// Things Prisma cannot express live only in the SQL migrations: CHECK constraints (status
// columns are plain String here, with string-literal unions in the domain layer), RLS, the
// updated_at triggers, expression/partial/HNSW indexes and the match_meeting_chunks function.
// `updatedAt` fields use @default(now()) because a database trigger maintains them.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  runtime                = "nodejs"
  // Explicit so generation does not depend on tsconfig discovery (e.g. in the Docker deps stage).
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  previewFeatures        = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, pg_trgm, vector(schema: "extensions")]
}

// -----------------------------------------------------------------------------
// Plans
// -----------------------------------------------------------------------------
model Plan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique
  name         String
  description  String?
  priceMonthly Decimal  @default(0) @map("price_monthly") @db.Decimal(10, 2)
  priceYearly  Decimal  @default(0) @map("price_yearly") @db.Decimal(10, 2)
  currency     String   @default("USD")
  features     Json     @default("[]")
  limits       Json     @default("{}")
  ctaLabel     String?  @map("cta_label")
  isDefault    Boolean  @default(false) @map("is_default")
  isPopular    Boolean  @default(false) @map("is_popular")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  users User[]

  @@map("plans")
}

// -----------------------------------------------------------------------------
// Users
// -----------------------------------------------------------------------------
model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String
  name        String?
  avatarUrl   String?   @map("avatar_url")
  googleSub   String?   @unique @map("google_sub")
  appleSub    String?   @unique @map("apple_sub")
  timezone    String    @default("UTC")
  locale      String    @default("en")
  status      String    @default("active")
  planId      String?   @map("plan_id") @db.Uuid
  onboardedAt DateTime? @map("onboarded_at") @db.Timestamptz(6)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  plan              Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  settings          UserSettings?
  profile           UserProfile?
  googleAccount     GoogleAccount?
  meetings          Meeting[]
  meetingReports    MeetingReport[]
  meetingChunks     MeetingChunk[]
  actionItems       ActionItem[]
  reminders         Reminder[]
  notifications     Notification[]
  devices           Device[]
  assistantThreads  AssistantThread[]
  assistantMessages AssistantMessage[]
  dailyCheckins     DailyCheckin[]
  companionNudges   CompanionNudge[]
  weeklyRecaps      WeeklyRecap[]
  connectedAccounts ConnectedAccount[]
  emailMessages     EmailMessage[]
  toolTasks         ToolTask[]

  @@index([createdAt(sort: Desc)], map: "users_created_at_idx")
  @@map("users")
}

model UserSettings {
  userId                 String    @id @map("user_id") @db.Uuid
  autoJoin               String    @default("all") @map("auto_join")
  botName                String?   @map("bot_name")
  meetingReminderMinutes Int       @default(30) @map("meeting_reminder_minutes")
  dailyDigest            Boolean   @default(true) @map("daily_digest")
  digestHour             Int       @default(8) @map("digest_hour")
  emailNotifications     Boolean   @default(true) @map("email_notifications")
  pushNotifications      Boolean   @default(true) @map("push_notifications")
  /// Daily rhythm, local "HH:MM" in the user's time zone.
  wakeTime               String    @default("07:30") @map("wake_time")
  quietHoursStart        String    @default("22:30") @map("quiet_hours_start")
  quietHoursEnd          String    @default("07:00") @map("quiet_hours_end")
  checkinTime            String    @default("21:00") @map("checkin_time")
  recordingConsentAt     DateTime? @map("recording_consent_at") @db.Timestamptz(6)
  /// Push the morning brief at wake time / ask "how did today go?" at check-in time.
  morningBrief           Boolean   @default(true) @map("morning_brief")
  eveningCheckin         Boolean   @default(true) @map("evening_checkin")
  /// Reading your email (user-flow §07): push important emails; VIPs always alert, muted senders never do.
  emailAlerts            Boolean   @default(true) @map("email_alerts")
  vipSenders             String[]  @default([]) @map("vip_senders")
  mutedSenders           String[]  @default([]) @map("muted_senders")
  /// How notifications decide (§09): normal pushes per local day before they are bundled into one.
  pushBudget             Int       @default(8) @map("push_budget")
  /// Critical alerts (timed reminders, meeting starting, urgent email) may break through quiet hours.
  criticalBreakThrough   Boolean   @default(false) @map("critical_break_through")
  /// Focus mode: treated like quiet hours until this time.
  focusUntil             DateTime? @map("focus_until") @db.Timestamptz(6)
  /// "Take a break": no friend nudges (brief, check-in, nudges, follow-ups) until this time.
  nudgesPausedUntil      DateTime? @map("nudges_paused_until") @db.Timestamptz(6)
  /// Per local hour "0".."23": [pushes sent, pushes opened]; the friend learns which times work.
  pushEngagement         Json      @default("{}") @map("push_engagement")
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_settings")
}

/// What the companion knows about the user's personality and style (built by the get-to-know-you chat).
model UserProfile {
  userId             String   @id @map("user_id") @db.Uuid
  status             String   @default("pending")
  preferredName      String?  @map("preferred_name")
  occupation         String?
  currentFocus       String?  @map("current_focus")
  communicationStyle String?  @map("communication_style")
  languageStyle      String   @default("english") @map("language_style")
  tone               String?
  facts              Json     @default("[]")
  summary            String?
  /// Relationship warmth 0..100 (night learning) and the stage it maps to (1 polite, 2 casual, 3 close).
  warmth             Int       @default(0)
  relationshipStage  Int       @default(1) @map("relationship_stage") @db.SmallInt
  learnedAt          DateTime? @map("learned_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_profiles")
}

model GoogleAccount {
  userId            String    @id @map("user_id") @db.Uuid
  googleEmail       String    @map("google_email")
  accessTokenEnc    String?   @map("access_token_enc")
  refreshTokenEnc   String?   @map("refresh_token_enc")
  scope             String?
  tokenExpiresAt    DateTime? @map("token_expires_at") @db.Timestamptz(6)
  calendarConnected Boolean   @default(false) @map("calendar_connected")
  calendarSyncToken String?   @map("calendar_sync_token")
  lastSyncedAt      DateTime? @map("last_synced_at") @db.Timestamptz(6)
  syncError         String?   @map("sync_error")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("google_accounts")
}

// -----------------------------------------------------------------------------
// Admins
// -----------------------------------------------------------------------------
model Admin {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String
  name         String
  passwordHash String    @map("password_hash")
  role         String    @default("editor")
  status       String    @default("active")
  avatarUrl    String?   @map("avatar_url")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  settings              AppSetting[]
  cmsPages              CmsPage[]
  mediaAssets           MediaAsset[]
  aiPrompts             AiPrompt[]
  notificationTemplates NotificationTemplate[]
  broadcasts            Broadcast[]
  auditLogs             AuditLog[]

  @@map("admins")
}

// -----------------------------------------------------------------------------
// Auth sessions (hashed refresh tokens, rotation families) for users + admins
// -----------------------------------------------------------------------------
model AuthSession {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectType String    @map("subject_type")
  subjectId   String    @map("subject_id") @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  userAgent   String?   @map("user_agent")
  ip          String?
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy  String?   @map("replaced_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  replacement  AuthSession?  @relation("SessionRotation", fields: [replacedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replacedFrom AuthSession[] @relation("SessionRotation")

  @@index([subjectType, subjectId], map: "auth_sessions_subject_idx")
  @@index([familyId], map: "auth_sessions_family_idx")
  @@map("auth_sessions")
}

// -----------------------------------------------------------------------------
// Meetings
// -----------------------------------------------------------------------------
model Meeting {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  source          String    @default("calendar")
  calendarEventId String?   @map("calendar_event_id")
  icalUid         String?   @map("ical_uid")
  title           String    @default("Untitled meeting")
  description     String?
  platform        String    @default("google_meet")
  meetingUrl      String?   @map("meeting_url")
  startAt         DateTime  @map("start_at") @db.Timestamptz(6)
  endAt           DateTime? @map("end_at") @db.Timestamptz(6)
  timezone        String?
  organizerEmail  String?   @map("organizer_email")
  isOrganizer     Boolean   @default(false) @map("is_organizer")
  attendees       Json      @default("[]")
  status          String    @default("scheduled")
  autoJoin        Boolean   @default(true) @map("auto_join")
  botJobId        String?   @map("bot_job_id")
  /// Which bot provider handled the meeting: self_hosted (Chromium runner) or recall (Recall.ai).
  botProvider     String?   @map("bot_provider")
  /// Provider-side bot id (Recall.ai bot UUID); webhooks are matched on it.
  externalBotId   String?   @unique @map("external_bot_id")
  botJoinedAt     DateTime? @map("bot_joined_at") @db.Timestamptz(6)
  botLeftAt       DateTime? @map("bot_left_at") @db.Timestamptz(6)
  failureReason   String?   @map("failure_reason")
  durationSeconds Int?      @map("duration_seconds")
  recordingPath   String?   @map("recording_path")
  language        String?
  /// Captures (source "capture"): idempotency key from the phone's upload queue.
  clientId        String?   @map("client_id")
  /// Captures: uploaded audio parts [{ index, path, durationMs, bytes }]; emptied once the audio is deleted.
  recordingParts  Json      @default("[]") @map("recording_parts")
  /// Captures: moments the user bookmarked while recording [{ atMs, label }].
  bookmarks       Json      @default("[]")
  /// Captures: when the user saved the review card.
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  /// Captures: the calendar event this recording belongs to.
  linkedMeetingId String?   @map("linked_meeting_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participants MeetingParticipant[]
  segments     TranscriptSegment[]
  report       MeetingReport?
  chunks       MeetingChunk[]
  actionItems  ActionItem[]
  reminders    Reminder[]
  linkedMeeting Meeting?  @relation("MeetingRecordings", fields: [linkedMeetingId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  recordings    Meeting[] @relation("MeetingRecordings")

  @@unique([userId, calendarEventId])
  @@unique([userId, clientId])
  @@index([userId, startAt(sort: Desc)], map: "meetings_user_start_idx")
  @@index([status], map: "meetings_status_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], map: "meetings_title_trgm_idx", type: Gin)
  @@map("meetings")
}

model MeetingParticipant {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId       String   @map("meeting_id") @db.Uuid
  name            String
  email           String?
  talkTimeSeconds Int      @default(0) @map("talk_time_seconds")
  wordCount       Int      @default(0) @map("word_count")
  talkRatio       Decimal  @default(0) @map("talk_ratio") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([meetingId, name])
  @@map("meeting_participants")
}

model TranscriptSegment {
  id        BigInt   @id @default(autoincrement())
  meetingId String   @map("meeting_id") @db.Uuid
  seq       Int
  speaker   String   @default("Unknown")
  text      String
  startMs   Int      @default(0) @map("start_ms")
  endMs     Int?     @map("end_ms")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([meetingId, seq])
  @@map("transcript_segments")
}

model MeetingReport {
  meetingId       String   @id @map("meeting_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  summary         String
  keyPoints       Json     @default("[]") @map("key_points")
  chapters        Json     @default("[]")
  keyQuestions    Json     @default("[]") @map("key_questions")
  decisions       Json     @default("[]")
  topics          String[] @default([])
  sentimentScore  Decimal? @map("sentiment_score") @db.Decimal(5, 2)
  engagementScore Decimal? @map("engagement_score") @db.Decimal(5, 2)
  meetingScore    Decimal? @map("meeting_score") @db.Decimal(5, 2)
  sentimentLabel  String?  @map("sentiment_label")
  model           String?
  promptVersion   Int?     @map("prompt_version")
  raw             Json?
  /// Captures: people, facts about the user, mood and reminders to confirm (CaptureInsights).
  insights        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "meeting_reports_user_idx")
  @@map("meeting_reports")
}

model MeetingChunk {
  id         BigInt                      @id @default(autoincrement())
  meetingId  String                      @map("meeting_id") @db.Uuid
  userId     String                      @map("user_id") @db.Uuid
  chunkIndex Int                         @map("chunk_index")
  content    String
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([meetingId, chunkIndex])
  @@index([userId], map: "meeting_chunks_user_idx")
  @@map("meeting_chunks")
}

// -----------------------------------------------------------------------------
// Action items, reminders, notifications, devices
// -----------------------------------------------------------------------------
model ActionItem {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  meetingId     String?   @map("meeting_id") @db.Uuid
  title         String
  description   String?
  assigneeName  String?   @map("assignee_name")
  assigneeEmail String?   @map("assignee_email")
  isMine        Boolean   @default(true) @map("is_mine")
  dueAt         DateTime? @map("due_at") @db.Timestamptz(6)
  priority      String    @default("medium")
  status        String    @default("open")
  source        String    @default("manual")
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  meeting   Meeting?   @relation(fields: [meetingId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reminders Reminder[]
  toolTasks ToolTask[]

  @@index([userId, status, dueAt], map: "action_items_user_status_idx")
  @@index([meetingId], map: "action_items_meeting_idx")
  @@map("action_items")
}

model Reminder {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  meetingId     String?   @map("meeting_id") @db.Uuid
  actionItemId  String?   @map("action_item_id") @db.Uuid
  type          String    @default("custom")
  title         String
  body          String?
  remindAt      DateTime  @map("remind_at") @db.Timestamptz(6)
  channels      String[]  @default(["push", "in_app"])
  status        String    @default("pending")
  source        String    @default("manual")
  jobId         String?   @map("job_id")
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  failureReason String?   @map("failure_reason")
  doneAt        DateTime? @map("done_at") @db.Timestamptz(6)
  /// Set when the one gentle follow-up for an ignored reminder went out.
  followedUpAt  DateTime? @map("followed_up_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  meeting    Meeting?    @relation(fields: [meetingId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  actionItem ActionItem? @relation(fields: [actionItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  emails     EmailMessage[]

  @@index([userId, remindAt], map: "reminders_user_time_idx")
  @@map("reminders")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "notifications_user_idx")
  @@map("notifications")
}

model Device {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  expoPushToken String   @unique @map("expo_push_token")
  platform      String
  deviceName    String?  @map("device_name")
  appVersion    String?  @map("app_version")
  lastSeenAt    DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "devices_user_idx")
  @@map("devices")
}

// -----------------------------------------------------------------------------
// Daily rhythm (user-flow §03): evening check-ins, proactive nudges, weekly recaps
// -----------------------------------------------------------------------------
/// One evening check-in per user per local day; mood/energy form the mood timeline.
model DailyCheckin {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  localDate   DateTime  @map("local_date") @db.Date
  status      String    @default("prompted")
  tone        String    @default("normal")
  messages    Json      @default("[]")
  mood        Int?      @db.SmallInt
  energy      Int?      @db.SmallInt
  wins        Json      @default("[]")
  summary     String?
  promptedAt  DateTime? @map("prompted_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, localDate])
  @@index([userId, localDate(sort: Desc)], map: "daily_checkins_user_date_idx")
  @@map("daily_checkins")
}

/// A rare proactive message from the friend (at most one per local day).
model CompanionNudge {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  localDate DateTime  @map("local_date") @db.Date
  text      String
  reason    String?
  sendAt    DateTime  @map("send_at") @db.Timestamptz(6)
  status    String    @default("scheduled")
  messages  Json      @default("[]")
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, localDate])
  @@index([userId, sendAt(sort: Desc)], map: "companion_nudges_user_idx")
  @@map("companion_nudges")
}

model WeeklyRecap {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  weekStart DateTime @map("week_start") @db.Date
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, weekStart])
  @@map("weekly_recaps")
}

// -----------------------------------------------------------------------------
// Connected apps (user-flow §07 email, §08 tools)
// -----------------------------------------------------------------------------
/// One connected Gmail / Outlook inbox or Notion / Jira / Linear / Todoist workspace per user and provider.
model ConnectedAccount {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  provider          String
  /// 'email' or 'tasks'.
  kind              String
  accountLabel      String?   @map("account_label")
  externalAccountId String?   @map("external_account_id")
  accessTokenEnc    String?   @map("access_token_enc")
  refreshTokenEnc   String?   @map("refresh_token_enc")
  tokenExpiresAt    DateTime? @map("token_expires_at") @db.Timestamptz(6)
  scope             String?
  /// 'connected' or 'needs_reconnect' (access expired or revoked).
  status            String    @default("connected")
  lastError         String?   @map("last_error")
  /// Email: { canSend }. Tools: { targetId, targetName, autoSend, siteUrl, cloudId }.
  settings          Json      @default("{}")
  /// Gmail historyId / Outlook last received time.
  syncCursor        String?   @map("sync_cursor")
  lastSyncedAt      DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  emails    EmailMessage[]
  toolTasks ToolTask[]

  @@unique([userId, provider])
  @@index([provider, status], map: "connected_accounts_provider_idx")
  @@map("connected_accounts")
}

/// What the friend kept from one email: never the body; sensitive mail keeps no subject or summary.
model EmailMessage {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  providerMessageId String    @map("provider_message_id")
  providerThreadId  String?   @map("provider_thread_id")
  fromName          String?   @map("from_name")
  fromEmail         String?   @map("from_email")
  subject           String?
  summary           String?
  why               String?
  category          String
  status            String    @default("new")
  /// [{ id, kind, title, dueAt, status }] deadlines, bills, bookings and travel.
  detected          Json      @default("[]")
  receivedAt        DateTime  @map("received_at") @db.Timestamptz(6)
  alertedAt         DateTime? @map("alerted_at") @db.Timestamptz(6)
  reminderId        String?   @map("reminder_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  account  ConnectedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reminder Reminder?        @relation(fields: [reminderId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([accountId, providerMessageId])
  @@index([userId, receivedAt(sort: Desc)], map: "email_messages_user_idx")
  @@index([userId, category, status, receivedAt(sort: Desc)], map: "email_messages_user_category_idx")
  @@map("email_messages")
}

/// The app's linked copy of a task created in Notion, Jira, Linear or Todoist.
model ToolTask {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  accountId     String?   @map("account_id") @db.Uuid
  provider      String
  actionItemId  String?   @map("action_item_id") @db.Uuid
  externalId    String?   @map("external_id")
  externalKey   String?   @map("external_key")
  url           String?
  title         String
  details       String?
  ownerName     String?   @map("owner_name")
  /// pending (not sent yet / retrying), open, done, failed.
  status        String    @default("pending")
  /// meeting, email, chat or manual.
  source        String    @default("manual")
  dueAt         DateTime? @map("due_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  attempts      Int       @default(0)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  account    ConnectedAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  actionItem ActionItem?       @relation(fields: [actionItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "tool_tasks_user_idx")
  @@map("tool_tasks")
}

// -----------------------------------------------------------------------------
// Ask AI
// -----------------------------------------------------------------------------
model AssistantThread {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  /// 'ask' (Ask AI over meetings) or 'talk' (the friend, user-flow §05).
  kind      String   @default("ask")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages AssistantMessage[]

  @@index([userId, kind, updatedAt(sort: Desc)], map: "assistant_threads_user_kind_idx")

  @@index([userId, updatedAt(sort: Desc)], map: "assistant_threads_user_idx")
  @@map("assistant_threads")
}

model AssistantMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId  String   @map("thread_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String
  content   String
  sources   Json     @default("[]")
  /// Talk: action cards (reminder set, meeting proposal, email draft, task).
  actions   Json     @default("[]")
  /// Talk: { intent, mood, crisis }.
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  thread AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([threadId, createdAt], map: "assistant_messages_thread_idx")
  @@map("assistant_messages")
}

// -----------------------------------------------------------------------------
// CMS / dynamic configuration
// -----------------------------------------------------------------------------
model AppSetting {
  key         String   @id
