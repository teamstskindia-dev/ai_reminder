# Public API origin used by the browser (the client appends /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:4000
# API origin for server-side fetches (public config, sections, plans, CMS pages). Can be an internal hostname.
API_URL_INTERNAL=http://localhost:4000
# Shared with the backend's WEB_REVALIDATE_SECRET; required by POST /api/revalidate.
REVALIDATE_SECRET=change-me
# Public site origin, used for canonical / Open Graph URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
