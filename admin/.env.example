# Direct mode (local development): the browser calls the API origin directly.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Same-origin mode (hosted admin, e.g. on *.vercel.app): the browser calls /api/v1 on the admin's own domain and the
# admin's server forwards it to API_PROXY_TARGET, so the API's auth cookies belong to the admin's domain.
# NEXT_PUBLIC_API_PROXY=true
# API_PROXY_TARGET=https://api.example.com
